import type { Duck } from "./DuckCard";

interface DuckMessage {
  tucks: Duck[];
}

export function DuckMessage({ tucks }: DuckMessage) {
  const ducks =
    tucks.length === 0
      ? "no ducks"
      : tucks.length <= 5
        ? "things are under control!"
        : tucks.length > 6
          ? "too many"
          : "";
  return ducks;
}
