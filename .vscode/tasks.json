{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "type": "shell",
      "command": "turbo run build --filter=${input:project}*"
    },
    {
      "label": "dev",
      "type": "shell",
      "command": "dotenv -e .dev.env -e .public.env -e .secret.env -- 'turbo run dev --filter=${input:project}*'",
      "problemMatcher": []
    },
    {
      "label": "serve",
      "type": "shell",
      "command": "dotenv -e .public.env -e .secret.env -- 'turbo run serve --filter=${input:project}*'"
    },
    {
      "label": "deploy",
      "type": "shell",
      "dependsOn": ["build", "serve"],
      "dependsOrder": "sequence"
    },
    {
      "label": "package",
      "type": "shell",
      "command": "docker compose -f .\\apps\\${input:project}\\${input:workspace}\\docker-compose.yml --env-file .public.env --env-file .secret.env build"
    },
    {
      "label": "deliver",
      "type": "shell",
      "command": "docker compose -f .\\apps\\${input:project}\\${input:workspace}\\docker-compose.yml --env-file .public.env --env-file .secret.env up"
    }
  ],
  "inputs": [
    {
      "id": "project",
      "description": "Full Stack Projects worth running",
      "type": "pickString",
      "options": ["template", "test", "scouting"]
    },

    {
      "id": "workspace",
      "description": "Workspaces within projects",
      "type": "pickString",
      "options": ["frontend", "backend"]
    }
  ]
}
